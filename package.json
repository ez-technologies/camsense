{
  "name": "camsense",
  "version": "0.1.0",
  "description": "Camera recognition for the browser: text, barcodes and the sharpest photo, on the phone",
  "type": "module",
  "license": "MIT",
  "repository": "github:ez-technologies/camsense",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "models",
    "scripts/copy-assets.mjs"
  ],
  "bin": {
    "camsense-copy-assets": "./scripts/copy-assets.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "lab": "node scripts/copy-assets.mjs lab/public/camsense && vite --config lab/vite.config.ts"
  },
  "dependencies": {
    "barcode-detector": "^3.2.3",
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
